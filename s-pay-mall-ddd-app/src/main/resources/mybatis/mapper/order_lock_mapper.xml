<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.bugstack.infrastructure.dao.IOrderLockDao">

    <resultMap id="dataMap" type="cn.bugstack.infrastructure.dao.po.payment.OrderLock">
        <id column="id" property="id"/>
        <result column="lock_id" property="lockId"/>
        <result column="order_id" property="orderId"/>
        <result column="lock_status" property="lockStatus"/>
        <result column="lock_time" property="lockTime"/>
        <result column="coupon_ids" property="couponIds"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- order_lock 仅记录锁单号/订单号/状态/时间，商品与用户信息由确认下单请求提供 -->
    <insert id="insert" parameterType="cn.bugstack.infrastructure.dao.po.payment.OrderLock">
        INSERT INTO order_lock(lock_id, order_id,
                               lock_status, lock_time, coupon_ids,
                               create_time, update_time)
        VALUES(#{lockId}, #{orderId},
               #{lockStatus}, #{lockTime}, #{couponIds},
               NOW(), NOW())
    </insert>

    <select id="queryByLockId" parameterType="java.lang.String" resultMap="dataMap">
        SELECT id, lock_id, order_id, lock_status, lock_time, coupon_ids
        FROM order_lock
        WHERE lock_id = #{lockId}
    </select>

    <update id="updateOrderId" parameterType="java.lang.String">
        UPDATE order_lock
        SET order_id = #{orderId}, lock_status = 'CONFIRMED', update_time = NOW()
        WHERE lock_id = #{lockId}
    </update>

    <update id="updateLockStatus" parameterType="java.lang.String">
        UPDATE order_lock
        SET lock_status = #{lockStatus}, update_time = NOW()
        WHERE lock_id = #{lockId}
    </update>

</mapper>
